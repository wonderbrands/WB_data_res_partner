<odoo>
    <data>
    <record  id="res_partner_form_inherit" model="ir.ui.view">

      <field name="name">res_partner_inherit</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
          <xpath expr="//field[@name='vat']" position="after">
              <field name="data_provider_key" placeholder="ej. PRO-000001"/>
          </xpath>
          <xpath expr="//group[@name='purchase']" position="after">
              <group>
                  <field name="data_wb_supplier"/>
              </group>
          </xpath>
      </field>
    </record>

	<record id="res_partner_form_inherit_2" model="ir.ui.view">
            <field name="name">res_partner_inherit_2</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <!-- Agrega campos al formulario de Compra -->
                <xpath expr="//group[@name='purchase']" position="after">
                    <group>
                        <field name="data_advance_payment_date"/>
                        <field name="data_percent_supplier_advance" widget="percentage"/>
                        <field name="data_lt_ag_channel"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
